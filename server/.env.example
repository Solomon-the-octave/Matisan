# Copy this file to .env and fill in real values for local development.
# In production (Render, etc.) these are set as real environment variables
# in the host's dashboard instead — no .env file is deployed.

# Postgres connection string. Local dev (matches the database created in
# the setup guide): postgresql://matisan:matisan_dev_pw@localhost:5432/matisan_hr
# Production (Neon, etc.): the connection string your provider gives you.
DATABASE_URL="postgresql://matisan:matisan_dev_pw@localhost:5432/matisan_hr?schema=public"

# Set this to "require" when your Postgres provider needs SSL (Neon,
# Render Postgres, Supabase, ...). Leave unset for a local database.
# PGSSL=require

# Secret used to sign login sessions (JWT). MUST be set to a long random
# value in production — the server refuses to start in production without
# one. Generate one with: openssl rand -hex 32
JWT_SECRET="dev-secret-change-me"

PORT=4000

# Optional — only used by `npm run db:seed` (the production seed, not the
# demo one). If unset, the seeded admin login defaults to
# admin@matisans.com / Admin@123 — change it before going live.
# SEED_ADMIN_EMAIL=admin@matisans.com
# SEED_ADMIN_PASSWORD=
